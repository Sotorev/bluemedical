FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache git

COPY package*.json ./
COPY tsconfig.json ./
COPY app.json ./

RUN npm ci

COPY src ./src
COPY __tests__ ./__tests__
COPY __mocks__ ./__mocks__
COPY index.tsx ./
COPY test-entrypoint.sh ./

RUN chmod +x test-entrypoint.sh

ENTRYPOINT ["./test-entrypoint.sh"]

